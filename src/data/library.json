  "_readme": {
    "isbn": "13-digit preferred, no dashes. This is the only required field; the build script uses it to fetch the cover and page count from Open Library.",
    "title": "Optional. Overrides whatever Open Library returns. Also used as the text on generated spines.",
    "author": "Optional. Same as title.",
    "shelf": "Which shelf it sits on, e.g. 'favourites', 'reading', 'want-to-read', 'technical'. Free-form string.",
    "rating": "Optional, 1-5.",
    "note": "Optional. A sentence or two shown when the book is clicked.",
    "spine": {
      "color": "Optional hex. Overrides the color sampled from the cover.",
      "textColor": "Optional hex.",
      "image": "Optional path under src/assets/library/ for a photographed spine. Skips procedural generation."
    },
    "cover": "Optional path under src/assets/library/ for a hand-supplied cover. Skips the Open Library fetch.",
    "pages": "Optional. Overrides the fetched page count, which sets the book's thickness."
  },
